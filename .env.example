# URL pública do site (usada em metadata, Open Graph, sitemap e canonical URLs)
NEXT_PUBLIC_SITE_URL=https://bpinfo.app.br

# URL de acesso ao sistema ORBYT (login do cliente)
NEXT_PUBLIC_ORBYT_URL=

# Número de WhatsApp para contato comercial, formato internacional sem símbolos
# Exemplo: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato comercial exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=
